# Bu dosyayı ".env" adıyla kopyalayıp doldurun, sonra: npm run build
# Boş bırakılan özellik kapalı kalır (site hiçbir yere veri göndermez).

# Make / Zapier / n8n webhook adresi
VITE_WEBHOOK_URL=

# Supabase üyelik (Project Settings → API). Yalnız "anon public" anahtarı yazın; "service_role" anahtarını ASLA yazmayın.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
